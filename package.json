{
  "name": "dead-by-craft",
  "productName": "DBC Launcher",
  "private": true,
  "version": "0.2.4",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview",
    "release": "vite build && electron-builder --publish always"
  },
  "build": {
    "appId": "com.abcizee.deadbycraft",
    "productName": "DBC Launcher",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "abcizee",
        "repo": "dbc-launcher"
      }
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.27.0",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sass": "^1.102.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "vite": "^8.1.1",
    "vite-plugin-electron": "^1.1.0"
  }
}
